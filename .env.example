# =============================================================================
# ToxScore Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env files to version control.
# =============================================================================

# --- Supabase ---
# Create a project at https://supabase.com and find these in Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct database connection (for backend/ETL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/toxscore

# --- Upstash Redis ---
# Create a Redis database at https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# --- Anthropic (Claude API) ---
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Stripe (billing, Phase 10+) ---
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# --- Application ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# --- EPA CompTox API (for ETL) ---
# Request a free key by emailing ccte_api@epa.gov
EPA_COMPTOX_API_KEY=your-comptox-key-here

# --- Sentry (error tracking) ---
SENTRY_DSN=https://your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
